# ── ساخته‌شده‌های cargo ─────────────────────────────────────────────
# پوشهٔ target/ همهٔ باینری‌ها، کتابخانه‌ها و کش کامپایل را دارد.
# هرگز آن را در Git نگذار (حجم زیاد + وابسته به پلتفرم + بی‌فایده).
/target/

# ── فایل قفل ────────────────────────────────────────────────────────
# برای «برنامه‌های» قابل اجرا (binary) باید Cargo.lock را کامیت کرد
# تا همه دقیقاً یک نسخه از وابستگی‌ها را بگیرند؛ پس اینجا کامیت می‌شود
# و در .gitignore نیست. (برای کتابخانه‌ها برعکس است.)
# Cargo.lock

# ── دادهٔ زمان اجرا ─────────────────────────────────────────────────
# تسک‌های محلی که خود برنامه می‌سازد؛ جزو سورس نیست.
/data/

# ── toolchain نصب‌شده به‌صورت محلی ────────────────────────────────────
# (روش نصب Rust داخل sandbox با npm — به scripts/setup-rust.sh نگاه کن)
/rust-toolchain-local/

# ── ادیتورها و سیستم ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── فایل‌های موقت ───────────────────────────────────────────────────
*.log
*.tmp
/tmp/
